# MulmoCast API Server Configuration
# Copy this file to .env and customize as needed

# Server Configuration
PORT=3000

# Base Paths Configuration
# Base directory for all MulmoCast operations (default: current working directory)
MULMOCAST_BASE_PATH=/path/to/your/project

# Output directory for generated files (default: {BASE_PATH}/output)
MULMOCAST_OUTPUT_PATH=/path/to/your/output

# Cache directory for temporary files (default: {OUTPUT_PATH}/cache)
MULMOCAST_CACHE_PATH=/path/to/your/cache

# Examples directory for static web client files (default: ./examples)
MULMOCAST_EXAMPLES_PATH=/path/to/your/examples

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_PROJECT_ID=your_google_project_id_here
NIJIVOICE_API_KEY=your_nijivoice_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
BROWSERLESS_API_TOKEN=your_browserless_api_token_here